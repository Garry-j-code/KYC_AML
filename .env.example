GROQ_API_KEY=your_groq_key_here
# Free tier: console.groq.com -> API Keys. GPT-OSS models support tool output.
MODEL_STRONG=openai/gpt-oss-120b   # orchestration reasoning + SAR narrative
MODEL_CHEAP=openai/gpt-oss-20b     # high-volume extraction

# Kaggle credentials (for scripts/download_data.sh). Get them from
# kaggle.com -> Settings -> API -> "Create New Token" (kaggle.json).
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key
